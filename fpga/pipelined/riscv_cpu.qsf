# Quartus settings for the DE10-Lite build of the pipelined core.
#
# PIN ASSIGNMENTS ARE DELIBERATELY NOT IN THIS FILE. See fpga/README.md --
# import them from Terasic's own file for your board revision instead. The port
# names in top_de10lite.sv match Terasic's conventions so their file drops in.

set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M50DAF484C7G
set_global_assignment -name TOP_LEVEL_ENTITY top_de10lite
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

# Packages first: a package must be compiled before the modules importing it.
set_global_assignment -name SYSTEMVERILOG_FILE ../../pkg/types.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../pkg/pipelined_types.sv

set_global_assignment -name SYSTEMVERILOG_FILE ../../hdl/common/alu.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../hdl/common/regfile.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../hdl/common/control.sv

set_global_assignment -name SYSTEMVERILOG_FILE ../../hdl/pipelined/stage_if.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../hdl/pipelined/stage_id.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../hdl/pipelined/stage_ex.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../hdl/pipelined/stage_mem.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../hdl/pipelined/stage_wb.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../hdl/pipelined/hazard.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../hdl/pipelined/cpu.sv

set_global_assignment -name SYSTEMVERILOG_FILE ../common/mem_sync.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../common/seven_seg.sv
set_global_assignment -name SYSTEMVERILOG_FILE top_de10lite.sv

set_global_assignment -name SDC_FILE riscv_cpu.sdc

set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
