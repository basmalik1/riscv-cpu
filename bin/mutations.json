{
  "fifo": {
    "testbench": "tb_fifo",
    "cases": [
      {
        "name": "full/empty wrap bit compared the wrong way",
        "old": "    assign full  = (head[PTR] != tail[PTR]) && (head[PTR-1:0] == tail[PTR-1:0]);",
        "new": "    assign full  = (head[PTR] == tail[PTR]) && (head[PTR-1:0] == tail[PTR-1:0]);"
      },
      {
        "name": "push not gated on full",
        "old": "    assign do_push = push && (!full || pop);",
        "new": "    assign do_push = push;"
      },
      {
        "name": "no push into a full queue even when popping",
        "old": "    assign do_push = push && (!full || pop);",
        "new": "    assign do_push = push && !full;"
      },
      {
        "name": "pop not gated on empty",
        "old": "    assign do_pop  = pop  && !empty;",
        "new": "    assign do_pop  = pop;"
      },
      {
        "name": "count computed backwards",
        "old": "    assign count = tail - head;",
        "new": "    assign count = head - tail;"
      },
      {
        "name": "INIT_FULL comes up empty",
        "old": "                tail <= {1'b1, {PTR{1'b0}}};    // DEPTH, so full",
        "new": "                tail <= '0;"
      },
      {
        "name": "INIT_BASE ignored, tags start at zero",
        "old": "                    mem[i] <= WIDTH'(INIT_BASE + unsigned'(i));",
        "new": "                    mem[i] <= WIDTH'((INIT_BASE * 0) + unsigned'(i));"
      },
      {
        "name": "head advances by two on a pop",
        "old": "                head <= head + 1'b1;",
        "new": "                head <= head + {{(PTR-1){1'b0}}, 2'd2};"
      },
      {
        "name": "push writes at the head instead of the tail",
        "old": "                mem[tail[PTR-1:0]] <= push_data;",
        "new": "                mem[head[PTR-1:0]] <= push_data;"
      }
    ]
  },
  "free_list": {
    "testbench": "tb_free_list",
    "cases": [
      {
        "name": "pool starts at 0, handing out architectural tags",
        "old": "        .INIT_BASE (ARCH_REGS)",
        "new": "        .INIT_BASE (0)"
      },
      {
        "name": "pool comes up empty instead of full",
        "old": "        .INIT_FULL (1'b1),",
        "new": "        .INIT_FULL (1'b0),"
      },
      {
        "name": "alloc_valid inverted",
        "old": "    assign alloc_valid = !pool_empty;",
        "new": "    assign alloc_valid = pool_empty;"
      },
      {
        "name": "first tag off by one",
        "old": "        .INIT_BASE (ARCH_REGS)",
        "new": "        .INIT_BASE (ARCH_REGS + 1)"
      },
      {
        "name": "commit frees the wrong tag",
        "old": "        .push_data (free_tag),",
        "new": "        .push_data (~free_tag),"
      },
      {
        "name": "allocate and free wired to the wrong ends of the queue",
        "old": "        .push      (free),\n        .push_data (free_tag),\n        .pop       (alloc),\n        .pop_data  (alloc_tag),",
        "new": "        .push      (alloc),\n        .push_data (free_tag),\n        .pop       (free),\n        .pop_data  (alloc_tag),"
      }
    ]
  },
  "rat": {
    "testbench": "tb_rat",
    "cases": [
      {
        "name": "write-first instead of read-first",
        "old": "    assign rs1_tag    = map[rs1_addr];\n    assign rs2_tag    = map[rs2_addr];",
        "new": "    assign rs1_tag    = (we && rs1_addr == rd_addr) ? rd_tag : map[rs1_addr];\n    assign rs2_tag    = (we && rs2_addr == rd_addr) ? rd_tag : map[rs2_addr];"
      },
      {
        "name": "rd_old_tag reports the new tag, not the displaced one",
        "old": "    assign rd_old_tag = map[rd_addr];",
        "new": "    assign rd_old_tag = we ? rd_tag : map[rd_addr];"
      },
      {
        "name": "x0 guard protects the wrong register",
        "old": "        end else if (we && (rd_addr != {ARCH_BITS{1'b0}})) begin",
        "new": "        end else if (we && (rd_addr != {ARCH_BITS{1'b1}})) begin"
      },
      {
        "name": "reset maps everything to physical register 0",
        "old": "                map[i] <= PHYS_BITS'(unsigned'(i));",
        "new": "                map[i] <= PHYS_BITS'(unsigned'(i) * 0);"
      },
      {
        "name": "reset identity off by one",
        "old": "                map[i] <= PHYS_BITS'(unsigned'(i));",
        "new": "                map[i] <= PHYS_BITS'(unsigned'(i) + 1);"
      },
      {
        "name": "write lands on the wrong entry",
        "old": "            map[rd_addr] <= rd_tag;",
        "new": "            map[rs1_addr] <= rd_tag;"
      },
      {
        "name": "rs2 reads a neighbouring entry",
        "old": "    assign rs2_tag    = map[rs2_addr];",
        "new": "    assign rs2_tag    = map[rs2_addr ^ 5'd1];"
      },
      {
        "name": "write enable inverted",
        "old": "        end else if (we && (rd_addr != {ARCH_BITS{1'b0}})) begin",
        "new": "        end else if (!we && (rd_addr != {ARCH_BITS{1'b0}})) begin"
      },
      {
        "name": "restore is ignored, leaving squashed mappings in place",
        "old": "        end else if (restore) begin",
        "new": "        end else if (restore && 1'b0) begin"
      },
      {
        "name": "a rename in the flush cycle wins over the restore",
        "old": "        end else if (restore) begin\n            // Ahead of the write on purpose. A rename in the cycle a flush\n            // starts belongs to an instruction being squashed, so applying it\n            // over the restored table would reintroduce exactly the mapping\n            // the restore exists to remove.\n            map <= restore_map;\n        end else if (we && (rd_addr != {ARCH_BITS{1'b0}})) begin\n            map[rd_addr] <= rd_tag;\n        end",
        "new": "        end else if (we && (rd_addr != {ARCH_BITS{1'b0}})) begin\n            map[rd_addr] <= rd_tag;\n        end else if (restore) begin\n            map <= restore_map;\n        end"
      },
      {
        "name": "map_out reports a stale copy of the table",
        "old": "    assign map_out = map;",
        "new": "    assign map_out = {map[0], map[ARCH_REGS-1:1]};"
      }
    ]
  },
  "prf": {
    "testbench": "tb_prf",
    "cases": [
      {
        "name": "allocate sets ready instead of clearing it",
        "old": "                ready[alloc_tag] <= 1'b0;",
        "new": "                ready[alloc_tag] <= 1'b1;"
      },
      {
        "name": "writeback clears ready instead of setting it",
        "old": "                ready[wb_tag] <= 1'b1;",
        "new": "                ready[wb_tag] <= 1'b0;"
      },
      {
        "name": "tag 0 value guard protects the wrong tag",
        "old": "    assign rs1_value    = (rs1_tag    == '0) ? 32'd0 : data[rs1_tag];",
        "new": "    assign rs1_value    = (rs1_tag    == '1) ? 32'd0 : data[rs1_tag];"
      },
      {
        "name": "tag 0 ready guard protects the wrong tag",
        "old": "    assign chk1_ready = (chk1_tag == '0) ? 1'b1 : ready[chk1_tag];",
        "new": "    assign chk1_ready = (chk1_tag == '1) ? 1'b1 : ready[chk1_tag];"
      },
      {
        "name": "a read bypass is added, so reads see the in-flight write",
        "old": "    assign rs1_value    = (rs1_tag    == '0) ? 32'd0 : data[rs1_tag];",
        "new": "    assign rs1_value    = (rs1_tag    == '0) ? 32'd0 : ((wb && wb_tag == rs1_tag) ? wb_value : data[rs1_tag]);"
      },
      {
        "name": "writeback lands on the allocated tag instead of its own",
        "old": "                data[wb_tag]  <= wb_value;",
        "new": "                data[alloc_tag]  <= wb_value;"
      },
      {
        "name": "rs2 reads a neighbouring register",
        "old": "    assign rs2_value    = (rs2_tag    == '0) ? 32'd0 : data[rs2_tag];",
        "new": "    assign rs2_value    = (rs2_tag    == '0) ? 32'd0 : data[rs2_tag ^ 6'd1];"
      },
      {
        "name": "reset leaves everything not ready",
        "old": "            ready <= '1;",
        "new": "            ready <= '0;"
      },
      {
        "name": "allocate enable inverted",
        "old": "            if (alloc) begin",
        "new": "            if (!alloc) begin"
      },
      {
        "name": "the commit trace port reads a neighbouring register",
        "old": "    assign commit_value = (commit_tag == '0) ? 32'd0 : data[commit_tag];",
        "new": "    assign commit_value = (commit_tag == '0) ? 32'd0 : data[commit_tag ^ 6'd1];"
      },
      {
        "name": "the second readiness lookup answers about the first register",
        "old": "    assign chk2_ready = (chk2_tag == '0) ? 1'b1 : ready[chk2_tag];",
        "new": "    assign chk2_ready = (chk2_tag == '0) ? 1'b1 : ready[chk1_tag];"
      }
    ]
  },
  "rob": {
    "testbench": "tb_rob",
    "cases": [
      {
        "name": "entries are marked done when allocated",
        "old": "                    done:        1'b0,",
        "new": "                    done:        1'b1,"
      },
      {
        "name": "the commit and squash free rules are swapped",
        "old": "            free_phys  = head_entry.rd_phys;\n        end else begin\n            free_valid = commit && head_entry.writes_reg;\n            free_phys  = head_entry.rd_old_phys;",
        "new": "            free_phys  = head_entry.rd_old_phys;\n        end else begin\n            free_valid = commit && head_entry.writes_reg;\n            free_phys  = head_entry.rd_phys;"
      },
      {
        "name": "a squashed entry releases the displaced tag, not its own",
        "old": "            free_phys  = head_entry.rd_phys;",
        "new": "            free_phys  = head_entry.rd_old_phys;"
      },
      {
        "name": "the mispredict test is inverted, so correct branches flush",
        "old": "                if (head_entry.mispredict) begin",
        "new": "                if (!head_entry.mispredict) begin"
      },
      {
        "name": "the mispredicting instruction is squashed, not committed",
        "old": "    assign commit            = !empty && head_entry.done && !flushing;",
        "new": "    assign commit            = !empty && head_entry.done && !flushing && !head_entry.mispredict;"
      },
      {
        "name": "allocation is allowed during the squash walk",
        "old": "    assign alloc_ready = !full && !flushing;",
        "new": "    assign alloc_ready = !full;"
      },
      {
        "name": "full and empty wrap bit compared the wrong way",
        "old": "    assign full  = (head[IDX] != tail[IDX]) && (head[IDX-1:0] == tail[IDX-1:0]);",
        "new": "    assign full  = (head[IDX] == tail[IDX]) && (head[IDX-1:0] == tail[IDX-1:0]);"
      },
      {
        "name": "completion marks the head instead of the entry it names",
        "old": "                entries[complete_idx].done        <= 1'b1;",
        "new": "                entries[head[IDX-1:0]].done        <= 1'b1;"
      },
      {
        "name": "the flush target is off by an instruction",
        "old": "                    flush_pc_q <= head_entry.redirect_pc;",
        "new": "                    flush_pc_q <= head_entry.redirect_pc + 32'd4;"
      },
      {
        "name": "a squashed entry frees regardless of writes_reg",
        "old": "            free_valid = !empty && head_entry.writes_reg;",
        "new": "            free_valid = !empty;"
      }
    ]
  },
  "issue_queue": {
    "testbench": "tb_issue_queue",
    "cases": [
      {
        "name": "select reads the post-wakeup state, issuing a cycle early",
        "old": "            if (entries[i].valid && entries[i].rs1_ready && entries[i].rs2_ready) begin",
        "new": "            if (woken[i].valid && woken[i].rs1_ready && woken[i].rs2_ready) begin"
      },
      {
        "name": "wakeup lets the last port overwrite an earlier match",
        "old": "            if (wake_valid[j] && (wake_tag[j] == tag)) begin\n                woken_by = 1'b1;\n            end",
        "new": "            woken_by = wake_valid[j] && (wake_tag[j] == tag);"
      },
      {
        "name": "selection runs ascending, so the youngest ready wins",
        "old": "        for (int i = int'(DEPTH) - 1; i >= 0; i--) begin",
        "new": "        for (int i = 0; i < int'(DEPTH); i++) begin"
      },
      {
        "name": "only rs1 is required to be ready",
        "old": "            if (entries[i].valid && entries[i].rs1_ready && entries[i].rs2_ready) begin",
        "new": "            if (entries[i].valid && entries[i].rs1_ready) begin"
      },
      {
        "name": "issue accept inverted, so a busy unit takes the work",
        "old": "    assign taking = issue_valid && issue_accept;",
        "new": "    assign taking = issue_valid && !issue_accept;"
      },
      {
        "name": "the collapse shifts the wrong way, keeping the issued entry",
        "old": "                if ((CB+1)'(unsigned'(i)) >= {1'b0, issue_idx}) begin",
        "new": "                if ((CB+1)'(unsigned'(i)) > {1'b0, issue_idx}) begin"
      },
      {
        "name": "a dispatch on its own wakeup cycle misses it",
        "old": "                rs1_ready: dispatch_rs1_ready || woken_by(dispatch_rs1),",
        "new": "                rs1_ready: dispatch_rs1_ready,"
      },
      {
        "name": "the queue accepts work past DEPTH",
        "old": "    assign dispatch_ready = (occupancy < (CB+1)'(DEPTH)) && !flush;",
        "new": "    assign dispatch_ready = !flush;"
      },
      {
        "name": "flush does not clear the entries",
        "old": "        if (rst || flush) begin",
        "new": "        if (rst) begin"
      }
    ]
  },
  "dispatch": {
    "testbench": "tb_dispatch",
    "cases": [
      {
        "name": "a tag is taken even when the rob or iq is full",
        "old": "    assign free_alloc = fire && allocates;",
        "new": "    assign free_alloc = valid && allocates;"
      },
      {
        "name": "the alias table is written even when dispatch does not fire",
        "old": "    assign rat_we     = fire && allocates;",
        "new": "    assign rat_we     = valid && allocates;"
      },
      {
        "name": "the rob is allocated even when dispatch does not fire",
        "old": "    assign rob_alloc  = fire;",
        "new": "    assign rob_alloc  = valid;"
      },
      {
        "name": "the prf allocate escapes the fire gate",
        "old": "    assign prf_alloc  = fire && allocates;",
        "new": "    assign prf_alloc  = valid && allocates;"
      },
      {
        "name": "readiness requires the pool to be EMPTY",
        "old": "    assign ready = rob_ready && iq_ready && (!allocates || free_valid);",
        "new": "    assign ready = rob_ready && iq_ready && (!allocates || !free_valid);"
      },
      {
        "name": "x0 destinations allocate a physical register",
        "old": "    assign allocates = regf_we && (rd_addr != 5'd0);",
        "new": "    assign allocates = regf_we;"
      },
      {
        "name": "the rob is told its own tag and the displaced one swapped",
        "old": "    assign rob_rd_phys     = free_tag;",
        "new": "    assign rob_rd_phys     = rat_rd_old_tag;"
      },
      {
        "name": "the register file is read at the wrong source tag",
        "old": "    assign prf_rs1_tag = rat_rs1_tag;",
        "new": "    assign prf_rs1_tag = rat_rs2_tag;"
      },
      {
        "name": "the issue queue is told the wrong readiness",
        "old": "    assign iq_rs1_ready = prf_rs1_ready;",
        "new": "    assign iq_rs1_ready = !prf_rs1_ready;"
      },
      {
        "name": "the payload claims x0 destinations write a register",
        "old": "        iq_payload.writes_reg  = allocates;",
        "new": "        iq_payload.writes_reg  = regf_we;"
      },
      {
        "name": "the store immediate has its halves swapped",
        "old": "            imm_s:   imm = {{20{inst[31]}}, inst[31:25], inst[11:7]};",
        "new": "            imm_s:   imm = {{20{inst[31]}}, inst[11:7], inst[31:25]};"
      }
    ]
  },
  "execute": {
    "testbench": "tb_execute",
    "cases": [
      {
        "name": "a divide blocks the fast path, killing latency hiding",
        "old": "    assign fast_can_go = !mem_busy && !mdu_done;",
        "new": "    assign fast_can_go = !mem_busy && !mdu_done && !mdu_busy;"
      },
      {
        "name": "arbitration inverted: the fast path wins over a finished divide",
        "old": "    assign fast_can_go = !mem_busy && !mdu_done;",
        "new": "    assign fast_can_go = 1'b1;"
      },
      {
        "name": "memory is allowed to run speculatively",
        "old": "                         && (issue_payload.rob_idx == rob_head_idx);",
        "new": "                         && (issue_payload.rob_idx != rob_head_idx);"
      },
      {
        "name": "a second divide is accepted while the first runs",
        "old": "    assign accept_div  = issue_valid && is_div && !mdu_busy;",
        "new": "    assign accept_div  = issue_valid && is_div;"
      },
      {
        "name": "multiplies are sent to the divider instead of the fast path",
        "old": "    assign is_div = issue_payload.is_muldiv &&  issue_payload.funct3[2];",
        "new": "    assign is_div = issue_payload.is_muldiv;"
      },
      {
        "name": "a not-taken branch reports a mispredict",
        "old": "                             || (issue_payload.is_branch && branch_taken);",
        "new": "                             || (issue_payload.is_branch && !branch_taken);"
      },
      {
        "name": "jalr does not clear bit 0 of its target",
        "old": "    assign fast_redirect   = issue_payload.is_jalr ? {alu_f[31:1], 1'b0} : alu_f;",
        "new": "    assign fast_redirect   = alu_f;"
      },
      {
        "name": "the divide result is taken from the fast path",
        "old": "            wb_value             = mdu_result;",
        "new": "            wb_value             = alu_f;"
      },
      {
        "name": "a store broadcasts a result",
        "old": "            wb_valid             = mem_payload.writes_reg;",
        "new": "            wb_valid             = !mem_payload.writes_reg;"
      },
      {
        "name": "the load completes the wrong reorder buffer entry",
        "old": "            complete_idx         = mem_payload.rob_idx;",
        "new": "            complete_idx         = ~mem_payload.rob_idx;"
      },
      {
        "name": "the memory access is not gated, so every instruction reads",
        "old": "    assign mem_start    = accept_mem;",
        "new": "    assign mem_start    = issue_valid;"
      }
    ]
  },
  "fetch": {
    "testbench": "tb_fetch",
    "cases": [
      {
        "name": "the replay select is inverted",
        "old": "    assign inst      = held_valid ? held_inst : imem_rdata;",
        "new": "    assign inst      = held_valid ? imem_rdata : held_inst;"
      },
      {
        "name": "the instruction is captured a cycle too late",
        "old": "        end else if (stall && !held_valid) begin",
        "new": "        end else if (stall && held_valid) begin"
      },
      {
        "name": "the two program counters are swapped",
        "old": "    assign imem_addr = pc_fetch;\n    assign pc        = pc_present;",
        "new": "    assign imem_addr = pc_present;\n    assign pc        = pc_fetch;"
      },
      {
        "name": "the pc advances during a stall",
        "old": "        end else if (!stall) begin\n            pc_present    <= pc_fetch;",
        "new": "        end else if (1'b1) begin\n            pc_present    <= pc_fetch;"
      },
      {
        "name": "a flush leaves the previous instruction looking valid",
        "old": "            valid_present <= 1'b0;\n        end else if (!stall) begin",
        "new": "            valid_present <= 1'b1;\n        end else if (!stall) begin"
      },
      {
        "name": "the pc advances by one byte rather than one instruction",
        "old": "            pc_fetch      <= pc_fetch + 32'd4;",
        "new": "            pc_fetch      <= pc_fetch + 32'd1;"
      }
    ]
  }
}
