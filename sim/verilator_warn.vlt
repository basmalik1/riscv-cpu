`verilator_config

// The package file is named for its contents rather than the package symbol;
// some of its constants are used only by the testbench, which Verilator cannot
// see when linting hdl/ alone.
lint_off -rule DECLFILENAME -file "*/pkg/types.sv"
lint_off -rule UNUSEDPARAM  -file "*/pkg/types.sv"

// control.sv takes the whole instruction word but only decodes the opcode,
// funct3 and inst[30]. The rs1/rs2/rd fields are read directly from `inst` by
// cpu.sv for the register file, so they are genuinely unused here. Permanent.
lint_off -rule UNUSEDSIGNAL -file "*/hdl/control.sv"


// $readmemh intentionally leaves the untouched tail of the array at its
// initial value rather than filling the whole memory.
lint_off -rule WIDTHTRUNC -file "*/hvl/common/magic_memory.sv"
